rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      // Allow anyone to read leaderboard entries
      allow read: if true;

      // Allow authenticated users (including anonymous auth) to create or update their own score document or profile sub-document
      allow create, update: if request.auth != null && (
        request.auth.uid == userId || 
        userId.matches('^' + request.auth.uid + '_.*') ||
        request.resource.data.uid == request.auth.uid
      );

      // Restrict deletion
      allow delete: if false;
    }

    match /weekly_stats/{docId} {
      // Allow anyone to read weekly stats
      allow read: if true;

      // Allow authenticated users to write their own weekly stats
      allow create, update: if request.auth != null && (
        request.auth.uid == docId ||
        docId.matches('^' + request.auth.uid + '_.*') ||
        request.resource.data.uid == request.auth.uid
      );
      allow delete: if false;
    }

    match /weekly_leagues/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      // Allow authenticated users to read/write their own sync profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow users to manage their own friends subcollection
      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /pendingRewards/{rewardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /usernames/{usernameDoc} {
      // Allow authenticated users to read usernames for search/discovery
      allow read: if request.auth != null;
      // Creation/modification allowed if user claims for themselves
      allow create, update: if request.auth != null && (
        request.resource.data.uid == request.auth.uid
      );
      allow delete: if false;
    }

    match /friend_codes/{codeDoc} {
      // Allow authenticated users to lookup friend codes
      allow read: if request.auth != null;
      // Creation/modification allowed if user locks code for themselves
      allow create, update: if request.auth != null && (
        request.resource.data.uid == request.auth.uid
      );
      allow delete: if false;
    }

    match /friend_requests/{requestId} {
      // Allow sender and receiver to read requests
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      // Allow sender to create a request
      allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      // Allow receiver to update status (accept/decline) or sender to cancel
      allow update: if request.auth != null && (
        resource.data.receiverUid == request.auth.uid ||
        resource.data.senderUid == request.auth.uid
      );
      // Allow sender to cancel or receiver to remove
      allow delete: if request.auth != null && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
    }

    match /feedback/{feedbackId} {
      // Allow creation of feedback entries
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.category in ['bug', 'idea', 'general', 'other'];
      // Disallow reading, updating, or deleting feedback from client SDK
      allow read, update, delete: if false;
    }
  }
}
