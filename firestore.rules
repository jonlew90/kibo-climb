rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      // Allow anyone to read leaderboard entries
      allow read: if true;

      // Allow authenticated users (including anonymous auth) to create or update their own score document
      allow create, update: if request.auth != null && request.auth.uid == userId;

      // Restrict deletion
      allow delete: if false;
    }

    match /users/{userId} {
      // Allow authenticated users to read/write their own sync profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
