rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      // Allow anyone to read leaderboard entries
      allow read: if true;

      // Allow authenticated users (including anonymous auth) to create or update their own score document or profile sub-document
      allow create, update: if request.auth != null && (
        request.auth.uid == userId || 
        userId.matches('^' + request.auth.uid + '_.*') ||
        request.resource.data.uid == request.auth.uid
      );

      // Restrict deletion
      allow delete: if false;
    }

    match /weekly_stats/{docId} {
      // Allow anyone to read weekly stats
      allow read: if true;

      // Allow authenticated users to write their own weekly stats
      allow create, update: if request.auth != null && (
        request.auth.uid == docId ||
        docId.matches('^' + request.auth.uid + '_.*') ||
        request.resource.data.uid == request.auth.uid
      );
      allow delete: if false;
    }

    match /weekly_leagues/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      // Allow authenticated users to read/write their own sync profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /feedback/{feedbackId} {
      // Allow creation of feedback entries
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.category in ['bug', 'idea', 'general', 'other'];
      // Disallow reading, updating, or deleting feedback from client SDK
      allow read, update, delete: if false;
    }

    match /usernames/{username} {
      // Allow anyone to read usernames to check availability or for profile info
      allow read: if request.auth != null;
      // Writes are strictly controlled via Cloud Functions
      allow write: if false;
    }
  }
}
